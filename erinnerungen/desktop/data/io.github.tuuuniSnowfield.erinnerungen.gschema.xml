<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="io.github.tuuuniSnowfield.erinnerungen" path="/io/github/tuuuniSnowfield/erinnerungen/">
    <key name="sync-mode" type="s">
      <default>"local"</default>
      <summary>Sync-Modus</summary>
      <description>caldav = eigener CalDAV-Server, folder = lokaler .ics-Ordner, local = nur lokal</description>
    </key>
    <key name="server-url" type="s">
      <default>""</default>
      <summary>CalDAV-Server-URL</summary>
    </key>
    <key name="username" type="s">
      <default>""</default>
      <summary>Benutzername</summary>
    </key>
    <key name="folder-path" type="s">
      <default>""</default>
      <summary>Ordner für .ics-Dateien</summary>
    </key>
    <key name="cert-pin" type="s">
      <default>""</default>
      <summary>Zertifikats-Pin (sha256/&lt;base64&gt; SPKI oder 64 Hex-Zeichen SHA-256 des DER-Zertifikats)</summary>
    </key>
    <key name="ca-file" type="s">
      <default>""</default>
      <summary>Optionaler eigener CA-Bundle (PEM)</summary>
    </key>
    <key name="window-width" type="i">
      <default>900</default>
    </key>
    <key name="window-height" type="i">
      <default>600</default>
    </key>
  </schema>
</schemalist>
